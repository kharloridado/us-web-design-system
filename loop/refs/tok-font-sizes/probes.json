{
  "_comment": "Checker-authored probes for item tok-font-sizes. The preview ships no type specimen, so a probe of :root alone would only re-read the declaration we are supposed to be auditing. Every ramp probe therefore INJECTS a real consumer element into the live cascade (OSUI base + dist/theme.css) and reads the USED font-size back out of getComputedStyle. The collateral probes measure OSUI's own widgets, which is the only way to see what redefining --font-size-xs actually does to the framework.",
  "waitFor": "main",
  "viewports": [
    {
      "name": "desktop",
      "width": 1280,
      "height": 900
    },
    {
      "name": "mobile",
      "width": 375,
      "height": 812
    }
  ],
  "probes": [
    {
      "name": "ramp / 3xs used",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-3xs)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "ramp / 2xs used",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-2xs)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "ramp / xs used",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-xs)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "ramp / sm used",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-sm)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "ramp / md used",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-md)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "ramp / lg used",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-lg)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "ramp / xl used",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-xl)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "ramp / 2xl used",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-2xl)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "ramp / 3xl used",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-3xl)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "cascade / who wins --font-size-xs",
      "js": "(()=>{return getComputedStyle(document.documentElement).getPropertyValue('--font-size-xs').trim();})()"
    },
    {
      "name": "cascade / ramp declared block",
      "js": "(()=>{const r=getComputedStyle(document.documentElement);return ['3xs','2xs','xs','sm','md','lg','xl','2xl','3xl'].map(s=>s+'='+r.getPropertyValue('--font-size-'+s).trim()).join(' ');})()"
    },
    {
      "name": "collateral / .btn.btn-small",
      "js": "(()=>{const b=document.createElement('button');b.className='btn btn-small';b.textContent='Small button';document.body.appendChild(b);const cs=getComputedStyle(b);const r=b.getBoundingClientRect();const o={fontSize:cs.fontSize,height:Math.round(r.height*100)/100,minHeight:cs.minHeight,paddingTop:cs.paddingTop,lineHeight:cs.lineHeight};b.remove();return o;})()"
    },
    {
      "name": "collateral / .btn (base, must be unchanged)",
      "js": "(()=>{const b=document.createElement('button');b.className='btn';b.textContent='Base button';document.body.appendChild(b);const cs=getComputedStyle(b);const r=b.getBoundingClientRect();const o={fontSize:cs.fontSize,height:Math.round(r.height*100)/100};b.remove();return o;})()"
    },
    {
      "name": "collateral / .badge.badge-small",
      "js": "(()=>{const e=document.createElement('span');e.className='badge badge-small';e.textContent='9';document.body.appendChild(e);const cs=getComputedStyle(e);const r=e.getBoundingClientRect();const o={fontSize:cs.fontSize,height:Math.round(r.height*100)/100,width:Math.round(r.width*100)/100};e.remove();return o;})()"
    },
    {
      "name": "collateral / .tag.tag-small",
      "js": "(()=>{const e=document.createElement('span');e.className='tag tag-small';e.textContent='Tag';document.body.appendChild(e);const cs=getComputedStyle(e);const r=e.getBoundingClientRect();const o={fontSize:cs.fontSize,height:Math.round(r.height*100)/100};e.remove();return o;})()"
    },
    {
      "name": "collateral / .avatar-small",
      "js": "(()=>{const e=document.createElement('div');e.className='avatar avatar-small';e.textContent='AB';document.body.appendChild(e);const cs=getComputedStyle(e);const r=e.getBoundingClientRect();const o={fontSize:cs.fontSize,height:Math.round(r.height*100)/100,width:Math.round(r.width*100)/100};e.remove();return o;})()"
    },
    {
      "name": "collateral / span.validation-message",
      "js": "(()=>{const e=document.createElement('span');e.className='validation-message';e.textContent='This field is required';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "collateral / .breadcrumbs-item .icon (glyph size)",
      "js": "(()=>{const w=document.createElement('div');w.className='breadcrumbs-item';const i=document.createElement('span');i.className='icon';w.appendChild(i);document.body.appendChild(w);const v=getComputedStyle(i).fontSize;w.remove();return v;})()"
    },
    {
      "name": "collateral / .form-control.input-small",
      "js": "(()=>{const e=document.createElement('input');e.className='form-control input-small';e.setAttribute('data-input','');document.body.appendChild(e);const cs=getComputedStyle(e);const r=e.getBoundingClientRect();const o={fontSize:cs.fontSize,height:Math.round(r.height*100)/100};e.remove();return o;})()"
    },
    {
      "name": "collateral / .font-size-xs utility",
      "js": "(()=>{const e=document.createElement('span');e.className='font-size-xs';e.textContent='x';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "untouched / .font-size-s utility (expect 14px)",
      "js": "(()=>{const e=document.createElement('span');e.className='font-size-s';e.textContent='x';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "untouched / --font-size-base + label + h1..h6 + display",
      "js": "(()=>{const r=getComputedStyle(document.documentElement);return ['base','label','h1','h2','h3','h4','h5','h6','display'].map(s=>s+'='+r.getPropertyValue('--font-size-'+s).trim()).join(' ');})()"
    },
    {
      "name": "removed / var(--font-size-s) resolves (OSUI 14px)",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-s)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "removed / var(--font-size-m, 16px) example fallback",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-m, 16px)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "removed / var(--font-size-l, 20px) example fallback",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-l, 20px)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "removed / bare var(--font-size-m) with NO fallback",
      "js": "(()=>{const e=document.createElement('span');e.style.fontSize='var(--font-size-m)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();return v;})()"
    },
    {
      "name": "zoom-proxy / px does not track root font-size",
      "js": "(()=>{const html=document.documentElement;const prev=html.style.fontSize;html.style.fontSize='32px';const e=document.createElement('span');e.style.fontSize='var(--font-size-sm)';document.body.appendChild(e);const v=getComputedStyle(e).fontSize;e.remove();html.style.fontSize=prev;return v;})()"
    },
    {
      "name": "overflow / .badge.badge-small 2 digits",
      "js": "(()=>{const e=document.createElement('span');e.className='badge badge-small';e.textContent='99';document.body.appendChild(e);const r={clip_x:e.scrollWidth-e.clientWidth,clip_y:e.scrollHeight-e.clientHeight,sw:e.scrollWidth,cw:e.clientWidth,sh:e.scrollHeight,ch:e.clientHeight,fs:getComputedStyle(e).fontSize};e.remove();return r;})()"
    },
    {
      "name": "overflow / .avatar-small initials",
      "js": "(()=>{const e=document.createElement('div');e.className='avatar avatar-small';e.textContent='AB';document.body.appendChild(e);const r={clip_x:e.scrollWidth-e.clientWidth,clip_y:e.scrollHeight-e.clientHeight,sw:e.scrollWidth,cw:e.clientWidth,sh:e.scrollHeight,ch:e.clientHeight,fs:getComputedStyle(e).fontSize};e.remove();return r;})()"
    },
    {
      "name": "overflow / .tag.tag-small",
      "js": "(()=>{const e=document.createElement('span');e.className='tag tag-small';e.textContent='Active';document.body.appendChild(e);const r={clip_x:e.scrollWidth-e.clientWidth,clip_y:e.scrollHeight-e.clientHeight,sw:e.scrollWidth,cw:e.clientWidth,sh:e.scrollHeight,ch:e.clientHeight,fs:getComputedStyle(e).fontSize};e.remove();return r;})()"
    },
    {
      "name": "overflow / .btn.btn-small",
      "js": "(()=>{const e=document.createElement('button');e.className='btn btn-small';e.textContent='Save changes';document.body.appendChild(e);const r={clip_x:e.scrollWidth-e.clientWidth,clip_y:e.scrollHeight-e.clientHeight,sw:e.scrollWidth,cw:e.clientWidth,sh:e.scrollHeight,ch:e.clientHeight,fs:getComputedStyle(e).fontSize};e.remove();return r;})()"
    },
    {
      "name": "overflow / .badge.badge-small at OSUI default 12px (control)",
      "js": "(()=>{const e=document.createElement('span');e.className='badge badge-small';e.style.setProperty('--font-size-xs','12px');e.textContent='99';document.body.appendChild(e);const r={clip_x:e.scrollWidth-e.clientWidth,clip_y:e.scrollHeight-e.clientHeight,sw:e.scrollWidth,cw:e.clientWidth,fs:getComputedStyle(e).fontSize};e.remove();return r;})()"
    }
  ]
}