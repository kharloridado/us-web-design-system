{
  "_comment": "Probes for item cmp-buttons. The harness measures; it never reads loop/refs/cmp-buttons/spec.md. Expected values live in the ref and the comparison is the checker judgment, not this file.",
  "waitFor": ".btn-primary",
  "viewports": [
    {
      "name": "desktop",
      "width": 1280,
      "height": 900
    },
    {
      "name": "mobile",
      "width": 375,
      "height": 812
    }
  ],
  "probes": [
    {
      "name": "geometry / regular button box — ref says 93 x 38",
      "selector": ".btn-primary:not(.uswds-btnspec__state--hover):not(.uswds-btnspec__state--active):not([disabled])",
      "rect": true
    },
    {
      "name": "geometry / big button box — ref says 120 x 52",
      "selector": ".btn-large:not(.uswds-btnspec__state--hover):not(.uswds-btnspec__state--active):not([disabled])",
      "rect": true
    },
    {
      "name": "geometry / outline button box — must equal the regular box (inside-aligned stroke)",
      "selector": ".btn:not([class*=btn-]):not([class*=uswds-btn--]):not(.uswds-btnspec__state--hover):not(.uswds-btnspec__state--active):not([disabled])",
      "rect": true
    },
    {
      "name": "type + box / regular button — ref: Public Sans Bold 16px, line-height 0.9, radius 4px, 2px border, padding 10/18",
      "selector": ".btn-primary:not(.uswds-btnspec__state--hover):not(.uswds-btnspec__state--active):not([disabled])",
      "props": [
        "font-family",
        "font-size",
        "font-weight",
        "line-height",
        "border-radius",
        "border-top-width",
        "padding-top",
        "padding-bottom",
        "padding-left",
        "padding-right",
        "height",
        "white-space",
        "text-align"
      ]
    },
    {
      "name": "type + box / big button — ref: 22px, padding 14/22",
      "selector": ".btn-large:not(.uswds-btnspec__state--hover):not(.uswds-btnspec__state--active):not([disabled])",
      "props": [
        "font-size",
        "font-weight",
        "line-height",
        "padding-top",
        "padding-bottom",
        "padding-left",
        "padding-right",
        "height"
      ]
    },
    {
      "name": "framework baseline / .btn resting filter (OSUI sets brightness(1); the hover/active override to none cannot be read from a static probe — verified by hover, see spec)",
      "selector": ".btn-primary:not(.uswds-btnspec__state--hover):not(.uswds-btnspec__state--active):not([disabled])",
      "props": [
        "filter",
        "transition-duration",
        "pointer-events"
      ]
    },
    {
      "name": "colour / primary default",
      "selector": ".btn-primary:not(.uswds-btnspec__state--hover):not(.uswds-btnspec__state--active):not([disabled])",
      "props": [
        "background-color",
        "color",
        "border-top-color",
        "border-top-width",
        "border-top-style"
      ]
    },
    {
      "name": "colour / primary hover",
      "selector": ".btn-primary.uswds-btnspec__state--hover",
      "props": [
        "background-color",
        "color",
        "border-top-color",
        "border-top-width",
        "border-top-style"
      ]
    },
